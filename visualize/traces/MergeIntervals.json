{"program":"MergeIntervals","meta":{"title":"Merge Intervals (sort by start, then stretch or add)","leetcode":"merge-intervals","expect":"[[1, 6], [8, 10], [15, 18]]","start":"merge","hide":"lambdas"},"code":"// @title Merge Intervals (sort by start, then stretch or add)\n// @leetcode merge-intervals\n// @expect [[1, 6], [8, 10], [15, 18]]\n// @start merge\n// @hide lambdas\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class MergeIntervals {\n    public static int[][] merge(int[][] intervals) {\n        Arrays.sort(intervals, (a, b) -> Integer.compare(a[0], b[0]));    // by start time\n        List<int[]> merged = new ArrayList<>();\n        for (int[] cur : intervals) {\n            int[] last = merged.isEmpty() ? null : merged.get(merged.size() - 1);\n            if (last != null && cur[0] <= last[1]) {\n                last[1] = Math.max(last[1], cur[1]);       // overlaps the last one: stretch it\n            } else {\n                merged.add(new int[]{cur[0], cur[1]});     // a gap: start a new interval\n            }\n        }\n        return merged.toArray(new int[0][]);\n    }\n\n    public static void main(String[] args) {\n        int[][] intervals = {{1, 3}, {2, 6}, {8, 10}, {15, 18}};\n        System.out.println(Arrays.deepToString(merge(intervals)));\n    }\n}\n","steps":[{"event":"step","line":12,"frames":[{"method":"main","class":"MergeIntervals","line":27,"locals":[["intervals",{"ref":"63"}]]},{"method":"merge","class":"MergeIntervals","line":12,"locals":[["intervals",{"ref":"63"}]]}],"heap":{"63":{"type":"int[][]","kind":"array","length":4,"items":[{"ref":"65"},{"ref":"66"},{"ref":"67"},{"ref":"68"}]},"65":{"type":"int[]","kind":"array","length":2,"items":[1,3]},"66":{"type":"int[]","kind":"array","length":2,"items":[2,6]},"67":{"type":"int[]","kind":"array","length":2,"items":[8,10]},"68":{"type":"int[]","kind":"array","length":2,"items":[15,18]}},"out":""},{"event":"step","line":12,"frames":[{"method"