{"program":"LongestSubstring","meta":{"title":"Longest Substring Without Repeating Characters (sliding window + set)","leetcode":"longest-substring-without-repeating-characters","expect":"3","start":"lengthOfLongestSubstring","pointers":"s: left right","window":"s: left right"},"code":"// @title Longest Substring Without Repeating Characters (sliding window + set)\n// @leetcode longest-substring-without-repeating-characters\n// @expect 3\n// @start lengthOfLongestSubstring\n// @pointers s: left right\n// @window s: left right\nimport java.util.HashSet;\nimport java.util.Set;\n\npublic class LongestSubstring {\n    public static int lengthOfLongestSubstring(String s) {\n        Set<Character> window = new HashSet<>();\n        int left = 0, best = 0;\n        for (int right = 0; right < s.length(); right++) {\n            char c = s.charAt(right);\n            while (window.contains(c)) {          // c is already inside: shrink from the left\n                window.remove(s.charAt(left));\n                left++;\n            }\n            window.add(c);\n            best = Math.max(best, right - left + 1);\n        }\n        return best;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(lengthOfLongestSubstring(\"abcabcbb\"));\n    }\n}\n","steps":[{"event":"step","line":12,"frames":[{"method":"main","class":"LongestSubstring","line":27,"locals":[]},{"method":"lengthOfLongestSubstring","class":"LongestSubstring","line":12,"locals":[["s",{"s":"abcabcbb"}]]}],"heap":{},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"LongestSubstring","line":27,"locals":[]},{"method":"lengthOfLongestSubstring","class":"LongestSubstring","line":13,"locals":[["s",{"s":"abcabcbb"}],["window",{"ref":"70"}]]}],"heap":{"70":{"type":"HashSet","kind":"set","items":[]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"LongestSubstring","line":27,"locals":[]},{"method":"lengthOfLongestSubstring","class":"LongestSub