{"program":"TwoSumHashMap","meta":{"title":"Two Sum — one pass with a HashMap","leetcode":"two-sum","expect":"[0, 1]","start":"twoSum","pointers":"nums: i"},"code":"// @title Two Sum — one pass with a HashMap\n// @leetcode two-sum\n// @expect [0, 1]\n// @start twoSum\n// @pointers nums: i\nimport java.util.Arrays;\nimport java.util.HashMap;\nimport java.util.Map;\n\npublic class TwoSumHashMap {\n    public static int[] twoSum(int[] nums, int target) {\n        Map<Integer, Integer> seen = new HashMap<>();     // value → index\n        for (int i = 0; i < nums.length; i++) {\n            int complement = target - nums[i];\n            if (seen.containsKey(complement)) {\n                return new int[]{seen.get(complement), i};\n            }\n            seen.put(nums[i], i);                         // insert AFTER checking → never pairs with itself\n        }\n        return new int[0];\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {2, 7, 11, 15};\n        System.out.println(Arrays.toString(twoSum(nums, 9)));\n    }\n}\n","steps":[{"event":"step","line":12,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":12,"locals":[["nums",{"ref":"63"}],["target",9]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":13,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":14,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],["i",0]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[]}},"out":""},{"event":"step","line":15,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":15,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],["i",0],["complement",7]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[]}},"out":""},{"event":"step","line":18,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":18,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],["i",0],["complement",7]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":13,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],["i",0]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[[2,0]]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":14,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],["i",1]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]},"70":{"type":"HashMap","kind":"map","entries":[[2,0]]}},"out":""},{"event":"step","line":15,"frames":[{"method":"main","class":"TwoSumHashMap","line":25,"locals":[["nums",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumHashMap","line":15,"locals":[["nums",{"ref":"63"}],["target",9],["seen",{"ref":"70"}],