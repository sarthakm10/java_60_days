{"program":"MaxSumWindow","meta":{"title":"Maximum sum subarray of size K (fixed sliding window)","set":"sliding-window","start":"maxSumOfK","pointers":"nums: right","window":"nums: right-k+1 right"},"code":"// @title Maximum sum subarray of size K (fixed sliding window)\n// @set sliding-window\n// @start maxSumOfK\n// @pointers nums: right\n// @window nums: right-k+1 right\npublic class MaxSumWindow {\n    public static int maxSumOfK(int[] nums, int k) {\n        if (k <= 0 || k > nums.length) throw new IllegalArgumentException(\"invalid k\");\n        int windowSum = 0;\n        for (int i = 0; i < k; i++) windowSum += nums[i];        // first window\n        int best = windowSum;\n        for (int right = k; right < nums.length; right++) {\n            windowSum += nums[right] - nums[right - k];          // slide: add new, drop old\n            best = Math.max(best, windowSum);\n        }\n        return best;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {2, 1, 5, 1, 3, 2};\n        System.out.println(maxSumOfK(nums, 3));\n    }\n}\n","steps":[{"event":"step","line":8,"frames":[{"method":"main","class":"MaxSumWindow","line":21,"locals":[["nums",{"ref":"64"}]]},{"method":"maxSumOfK","class":"MaxSumWindow","line":8,"locals":[["nums",{"ref":"64"}],["k",3]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items":[2,1,5,1,3,2]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"MaxSumWindow","line":21,"locals":[["nums",{"ref":"64"}]]},{"method":"maxSumOfK","class":"MaxSumWindow","line":9,"locals":[["nums",{"ref":"64"}],["k",3]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items":[2,1,5,1,3,2]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"MaxSumWindow","line":21,"locals":[["nums",{"ref":"64"}]]},{"method":"maxSumOfK","class":"MaxSumWindow","line":10,"locals":[["nums",{"ref":"64"}],["k",3],["windowSum",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items