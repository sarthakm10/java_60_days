{"program":"SortColors","meta":{"title":"Sort Colors (Dutch national flag: low / mid / high)","leetcode":"sort-colors","expect":"[0, 0, 1, 1, 2, 2]","start":"sortColors","hide":"swap","pointers":"nums: low mid high"},"code":"// @title Sort Colors (Dutch national flag: low / mid / high)\n// @leetcode sort-colors\n// @expect [0, 0, 1, 1, 2, 2]\n// @start sortColors\n// @hide swap\n// @pointers nums: low mid high\nimport java.util.Arrays;\n\npublic class SortColors {\n    public static void sortColors(int[] nums) {\n        int low = 0, mid = 0, high = nums.length - 1;\n        while (mid <= high) {\n            if (nums[mid] == 0) swap(nums, low++, mid++);         // 0s go to the front\n            else if (nums[mid] == 2) swap(nums, mid, high--);     // 2s go to the back\n            else mid++;                                           // 1s stay in the middle\n        }\n    }\n\n    static void swap(int[] a, int i, int j) {\n        int t = a[i];\n        a[i] = a[j];\n        a[j] = t;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {2, 0, 2, 1, 1, 0};\n        sortColors(nums);\n        System.out.println(Arrays.toString(nums));\n    }\n}\n","steps":[{"event":"step","line":11,"frames":[{"method":"main","class":"SortColors","line":27,"locals":[["nums",{"ref":"63"}]]},{"method":"sortColors","class":"SortColors","line":11,"locals":[["nums",{"ref":"63"}]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[2,0,2,1,1,0]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"SortColors","line":27,"locals":[["nums",{"ref":"63"}]]},{"method":"sortColors","class":"SortColors","line":12,"locals":[["nums",{"ref":"63"}],["low",0],["mid",0],["high",5]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[2,0,2,1,1,0]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"SortColors","line":27,"locals":[["nums",{"ref":"63"}]]},{"method":"sortColors","class":"SortColors","line":13,"lo