{"program":"MiddleOfList","meta":{"title":"Middle of the Linked List (slow and fast pointers)","leetcode":"middle-of-the-linked-list","expect":"3 4 5","start":"middleNode"},"code":"// @title Middle of the Linked List (slow and fast pointers)\n// @leetcode middle-of-the-linked-list\n// @expect 3 4 5\n// @start middleNode\npublic class MiddleOfList {\n    static class ListNode {\n        int val;\n        ListNode next;\n        ListNode(int val) { this.val = val; }\n    }\n\n    public static ListNode middleNode(ListNode head) {\n        ListNode slow = head, fast = head;\n        while (fast != null && fast.next != null) {\n            slow = slow.next;          // one step\n            fast = fast.next.next;     // two steps: when fast reaches the end, slow is halfway\n        }\n        return slow;\n    }\n\n    public static void main(String[] args) {\n        ListNode head = new ListNode(1), tail = head;\n        for (int v = 2; v <= 5; v++) tail = tail.next = new ListNode(v);\n        ListNode middle = middleNode(head);\n        for (ListNode n = middle; n != null; n = n.next) System.out.print(n.val + \" \");\n        System.out.println();\n    }\n}\n","steps":[{"event":"step","line":13,"frames":[{"method":"main","class":"MiddleOfList","line":24,"locals":[["head",{"ref":"65"}],["tail",{"ref":"66"}]]},{"method":"middleNode","class":"MiddleOfList","line":13,"locals":[["head",{"ref":"65"}]]}],"heap":{"65":{"type":"MiddleOfList.ListNode","kind":"object","fields":[["val",1],["next",{"ref":"67"}]]},"66":{"type":"MiddleOfList.ListNode","kind":"object","fields":[["val",5],["next",null]]},"67":{"type":"MiddleOfList.ListNode","kind":"object","fields":[["val",2],["next",{"ref":"68"}]]},"68":{"type":"MiddleOfList.ListNode","kind":"object","fields":[["val",3],["next",{"ref":"69"}]]},"69":{"type":"MiddleOfList.ListNode","kind":"object","fields":[["val",4],["next",{"ref":"66"}]]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"MiddleOfList","line":24