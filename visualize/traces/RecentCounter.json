{"program":"RecentCounter","meta":{"title":"Number of Recent Calls (a queue of timestamps)","leetcode":"number-of-recent-calls","expect":"1 2 3 3","start":"ping"},"code":"// @title Number of Recent Calls (a queue of timestamps)\n// @leetcode number-of-recent-calls\n// @expect 1 2 3 3\n// @start ping\nimport java.util.ArrayDeque;\nimport java.util.Queue;\n\npublic class RecentCounter {\n    private final Queue<Integer> requests = new ArrayDeque<>();\n\n    public int ping(int t) {\n        requests.offer(t);\n        while (requests.peek() < t - 3000) {      // drop calls older than 3000 ms\n            requests.poll();\n        }\n        return requests.size();\n    }\n\n    public static void main(String[] args) {\n        RecentCounter counter = new RecentCounter();\n        int a = counter.ping(1);\n        int b = counter.ping(100);\n        int c = counter.ping(3001);\n        int d = counter.ping(3002);\n        System.out.println(a + \" \" + b + \" \" + c + \" \" + d);\n    }\n}\n","steps":[{"event":"step","line":12,"frames":[{"method":"main","class":"RecentCounter","line":21,"locals":[["counter",{"ref":"63"}]]},{"method":"ping","class":"RecentCounter","line":12,"locals":[["this",{"ref":"63"}],["t",1]]}],"heap":{"63":{"type":"RecentCounter","kind":"object","fields":[["requests",{"ref":"64"}]]},"64":{"type":"ArrayDeque","kind":"deque","items":[]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"RecentCounter","line":21,"locals":[["counter",{"ref":"63"}]]},{"method":"ping","class":"RecentCounter","line":13,"locals":[["this",{"ref":"63"}],["t",1]]}],"heap":{"63":{"type":"RecentCounter","kind":"object","fields":[["requests",{"ref":"64"}]]},"64":{"type":"ArrayDeque","kind":"deque","items":[1]}},"out":""},{"event":"step","line":16,"frames":[{"method":"main","class":"RecentCounter","line":21,"locals":[["counter",{"ref":"63"}]]},{"method":"ping","class":"RecentCounter","line":16,"locals":[["this",{"ref":"63"}],["t",1]]}],"heap":{"63":{"type":