{"program":"UniquePaths","meta":{"title":"Unique Paths (2D dynamic programming on a grid)","leetcode":"unique-paths","expect":"28","start":"uniquePaths","cell":"dp: r c"},"code":"// @title Unique Paths (2D dynamic programming on a grid)\n// @leetcode unique-paths\n// @expect 28\n// @start uniquePaths\n// @cell dp: r c\npublic class UniquePaths {\n    public static int uniquePaths(int m, int n) {\n        int[][] dp = new int[m][n];                                  // dp[r][c] = paths from the start to (r, c)\n        for (int r = 0; r < m; r++) {\n            for (int c = 0; c < n; c++) {\n                if (r == 0 || c == 0) dp[r][c] = 1;                  // top row and left column: one way\n                else dp[r][c] = dp[r - 1][c] + dp[r][c - 1];        // from above + from the left\n            }\n        }\n        return dp[m - 1][n - 1];\n    }\n\n    public static void main(String[] args) {\n        System.out.println(uniquePaths(3, 7));\n    }\n}\n","steps":[{"event":"step","line":8,"frames":[{"method":"main","class":"UniquePaths","line":19,"locals":[]},{"method":"uniquePaths","class":"UniquePaths","line":8,"locals":[["m",3],["n",7]]}],"heap":{},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"UniquePaths","line":19,"locals":[]},{"method":"uniquePaths","class":"UniquePaths","line":9,"locals":[["m",3],["n",7],["dp",{"ref":"69"}]]}],"heap":{"69":{"type":"int[][]","kind":"array","length":3,"items":[{"ref":"71"},{"ref":"72"},{"ref":"73"}]},"71":{"type":"int[]","kind":"array","length":7,"items":[0,0,0,0,0,0,0]},"72":{"type":"int[]","kind":"array","length":7,"items":[0,0,0,0,0,0,0]},"73":{"type":"int[]","kind":"array","length":7,"items":[0,0,0,0,0,0,0]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"UniquePaths","line":19,"locals":[]},{"method":"uniquePaths","class":"UniquePaths","line":10,"locals":[["m",3],["n",7],["dp",{"ref":"69"}],["r",0]]}],"heap":{"69":{"type":"int[][]","kind":"array","length":3,"items":[{