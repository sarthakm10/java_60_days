{"program":"FindPivotIndex","meta":{"title":"Find Pivot Index (prefix sum: left side vs right side)","leetcode":"find-pivot-index","expect":"3","start":"pivotIndex","pointers":"nums: i","window":"nums: 0 i-1"},"code":"// @title Find Pivot Index (prefix sum: left side vs right side)\n// @leetcode find-pivot-index\n// @expect 3\n// @start pivotIndex\n// @pointers nums: i\n// @window nums: 0 i-1\npublic class FindPivotIndex {\n    public static int pivotIndex(int[] nums) {\n        int total = 0;\n        for (int x : nums) total += x;\n        int leftSum = 0;                                  // sum of everything left of i\n        for (int i = 0; i < nums.length; i++) {\n            int rightSum = total - leftSum - nums[i];\n            if (leftSum == rightSum) return i;\n            leftSum += nums[i];\n        }\n        return -1;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {1, 7, 3, 6, 5, 6};\n        System.out.println(pivotIndex(nums));\n    }\n}\n","steps":[{"event":"step","line":9,"frames":[{"method":"main","class":"FindPivotIndex","line":22,"locals":[["nums",{"ref":"63"}]]},{"method":"pivotIndex","class":"FindPivotIndex","line":9,"locals":[["nums",{"ref":"63"}]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[1,7,3,6,5,6]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"FindPivotIndex","line":22,"locals":[["nums",{"ref":"63"}]]},{"method":"pivotIndex","class":"FindPivotIndex","line":10,"locals":[["nums",{"ref":"63"}],["total",0]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[1,7,3,6,5,6]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"FindPivotIndex","line":22,"locals":[["nums",{"ref":"63"}]]},{"method":"pivotIndex","class":"FindPivotIndex","line":11,"locals":[["nums",{"ref":"63"}],["total",28]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[1,7,3,6,5,6]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","