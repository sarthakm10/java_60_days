{"program":"SpiralMatrix","meta":{"title":"Spiral Matrix (shrink four borders)","leetcode":"spiral-matrix","expect":"[1, 2, 3, 6, 9, 8, 7, 4, 5]","start":"spiralOrder"},"code":"// @title Spiral Matrix (shrink four borders)\n// @leetcode spiral-matrix\n// @expect [1, 2, 3, 6, 9, 8, 7, 4, 5]\n// @start spiralOrder\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class SpiralMatrix {\n    public static List<Integer> spiralOrder(int[][] matrix) {\n        List<Integer> order = new ArrayList<>();\n        int top = 0, bottom = matrix.length - 1, left = 0, right = matrix[0].length - 1;\n        while (top <= bottom && left <= right) {\n            for (int c = left; c <= right; c++) order.add(matrix[top][c]);        // along the top, left to right\n            top++;\n            for (int r = top; r <= bottom; r++) order.add(matrix[r][right]);      // down the right side\n            right--;\n            if (top <= bottom) {\n                for (int c = right; c >= left; c--) order.add(matrix[bottom][c]); // along the bottom, right to left\n                bottom--;\n            }\n            if (left <= right) {\n                for (int r = bottom; r >= top; r--) order.add(matrix[r][left]);   // up the left side\n                left++;\n            }\n        }\n        return order;\n    }\n\n    public static void main(String[] args) {\n        int[][] matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};\n        System.out.println(spiralOrder(matrix));\n    }\n}\n","steps":[{"event":"step","line":10,"frames":[{"method":"main","class":"SpiralMatrix","line":31,"locals":[["matrix",{"ref":"64"}]]},{"method":"spiralOrder","class":"SpiralMatrix","line":10,"locals":[["matrix",{"ref":"64"}]]}],"heap":{"64":{"type":"int[][]","kind":"array","length":3,"items":[{"ref":"66"},{"ref":"67"},{"ref":"68"}]},"66":{"type":"int[]","kind":"array","length":3,"items":[1,2,3]},"67":{"type":"int[]","kind":"array","length":3,"items":[4,5,6]},"68":{"type":"int[]","kind":"array","lengt