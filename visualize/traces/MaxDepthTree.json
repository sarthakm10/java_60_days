{"program":"MaxDepthTree","meta":{"title":"Maximum depth of a binary tree (recursion on a tree)","start":"maxDepth"},"code":"// @title Maximum depth of a binary tree (recursion on a tree)\n// @start maxDepth\npublic class MaxDepthTree {\n    static class TreeNode {\n        int val;\n        TreeNode left, right;\n        TreeNode(int val) { this.val = val; }\n    }\n\n    public static int maxDepth(TreeNode root) {\n        if (root == null) return 0;                               // empty tree has depth 0\n        return 1 + Math.max(maxDepth(root.left), maxDepth(root.right));\n    }\n\n    public static void main(String[] args) {\n        TreeNode root = new TreeNode(3);\n        root.left = new TreeNode(9);\n        root.right = new TreeNode(20);\n        root.right.left = new TreeNode(15);\n        root.right.right = new TreeNode(7);\n        System.out.println(maxDepth(root));\n    }\n}\n","steps":[{"event":"step","line":11,"frames":[{"method":"main","class":"MaxDepthTree","line":21,"locals":[["root",{"ref":"64"}]]},{"method":"maxDepth","class":"MaxDepthTree","line":11,"locals":[["root",{"ref":"64"}]]}],"heap":{"64":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",3],["left",{"ref":"65"}],["right",{"ref":"66"}]]},"65":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",9],["left",null],["right",null]]},"66":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",20],["left",{"ref":"67"}],["right",{"ref":"68"}]]},"67":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",15],["left",null],["right",null]]},"68":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",7],["left",null],["right",null]]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"MaxDepthTree","line":21,"locals":[["root",{"ref":"64"}]]},{"method":"maxDepth","class":"MaxDepthTree","line":12,"locals":[["root",{"ref":"64"}]]}],"heap":{"64":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",3],["left",{"