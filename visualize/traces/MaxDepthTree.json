{"program":"MaxDepthTree","meta":{"title":"Maximum depth of a binary tree (recursion on a tree)","leetcode":"maximum-depth-of-binary-tree","expect":"3","start":"maxDepth"},"code":"// @title Maximum depth of a binary tree (recursion on a tree)\n// @leetcode maximum-depth-of-binary-tree\n// @expect 3\n// @start maxDepth\npublic class MaxDepthTree {\n    static class TreeNode {\n        int val;\n        TreeNode left, right;\n        TreeNode(int val) { this.val = val; }\n    }\n\n    public static int maxDepth(TreeNode root) {\n        if (root == null) return 0;                               // empty tree has depth 0\n        return 1 + Math.max(maxDepth(root.left), maxDepth(root.right));\n    }\n\n    public static void main(String[] args) {\n        TreeNode root = new TreeNode(3);\n        root.left = new TreeNode(9);\n        root.right = new TreeNode(20);\n        root.right.left = new TreeNode(15);\n        root.right.right = new TreeNode(7);\n        System.out.println(maxDepth(root));\n    }\n}\n","steps":[{"event":"step","line":13,"frames":[{"method":"main","class":"MaxDepthTree","line":23,"locals":[["root",{"ref":"65"}]]},{"method":"maxDepth","class":"MaxDepthTree","line":13,"locals":[["root",{"ref":"65"}]]}],"heap":{"65":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",3],["left",{"ref":"66"}],["right",{"ref":"67"}]]},"66":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",9],["left",null],["right",null]]},"67":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",20],["left",{"ref":"68"}],["right",{"ref":"69"}]]},"68":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",15],["left",null],["right",null]]},"69":{"type":"MaxDepthTree.TreeNode","kind":"object","fields":[["val",7],["left",null],["right",null]]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"MaxDepthTree","line":23,"locals":[["root",{"ref":"65"}]]},{"method":"maxDepth","class":"MaxDepthTree","line":14,"locals":[["ro