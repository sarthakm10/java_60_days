{"program":"ReverseArray","meta":{"title":"Reverse an array in place (two pointers)","set":"two-pointers","start":"reverse","pointers":"arr: left right"},"code":"// @title Reverse an array in place (two pointers)\n// @set two-pointers\n// @start reverse\n// @pointers arr: left right\nimport java.util.Arrays;\n\npublic class ReverseArray {\n    public static void reverse(int[] arr) {\n        int left = 0, right = arr.length - 1;\n        while (left < right) {\n            int tmp = arr[left];\n            arr[left] = arr[right];\n            arr[right] = tmp;\n            left++;\n            right--;\n        }\n    }\n\n    public static void main(String[] args) {\n        int[] arr = {1, 2, 3, 4, 5};\n        reverse(arr);\n        System.out.println(Arrays.toString(arr));\n    }\n}\n","steps":[{"event":"step","line":9,"frames":[{"method":"main","class":"ReverseArray","line":21,"locals":[["arr",{"ref":"64"}]]},{"method":"reverse","class":"ReverseArray","line":9,"locals":[["arr",{"ref":"64"}]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[1,2,3,4,5]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"ReverseArray","line":21,"locals":[["arr",{"ref":"64"}]]},{"method":"reverse","class":"ReverseArray","line":10,"locals":[["arr",{"ref":"64"}],["left",0],["right",4]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[1,2,3,4,5]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"ReverseArray","line":21,"locals":[["arr",{"ref":"64"}]]},{"method":"reverse","class":"ReverseArray","line":11,"locals":[["arr",{"ref":"64"}],["left",0],["right",4]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[1,2,3,4,5]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"ReverseArray","line":21,"locals":[["arr",{"ref":"64"}]]},{"method":"reverse","class":"ReverseArray","line":12,"locals":[["arr",{"ref":"64"}],["left",0],["right",4],["tmp",1]]}],"heap":{"64":{"type":"int[]"