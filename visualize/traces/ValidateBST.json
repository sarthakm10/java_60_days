{"program":"ValidateBST","meta":{"title":"Validate Binary Search Tree (each node gets an allowed range)","leetcode":"validate-binary-search-tree","expect":"false","start":"isValidBST"},"code":"// @title Validate Binary Search Tree (each node gets an allowed range)\n// @leetcode validate-binary-search-tree\n// @expect false\n// @start isValidBST\nimport java.util.ArrayDeque;\nimport java.util.List;\nimport java.util.Queue;\n\npublic class ValidateBST {\n    static class TreeNode {\n        int val;\n        TreeNode left, right;\n        TreeNode(int val) { this.val = val; }\n    }\n\n    public static boolean isValidBST(TreeNode root) {\n        return valid(root, Long.MIN_VALUE, Long.MAX_VALUE);\n    }\n\n    static boolean valid(TreeNode node, long low, long high) {\n        if (node == null) return true;\n        if (node.val <= low || node.val >= high) return false;     // outside what its ancestors allow\n        return valid(node.left, low, node.val) && valid(node.right, node.val, high);\n    }\n\n    public static void main(String[] args) {\n        TreeNode root = build(5, 1, 4, null, null, 3, 6);\n        System.out.println(isValidBST(root));\n    }\n\n    // LeetCode's level-order list → a tree\n    static TreeNode build(Integer... values) {\n        TreeNode root = new TreeNode(values[0]);\n        Queue<TreeNode> queue = new ArrayDeque<>(List.of(root));\n        for (int i = 1; i < values.length; i += 2) {\n            TreeNode node = queue.poll();\n            if (values[i] != null) queue.offer(node.left = new TreeNode(values[i]));\n            if (i + 1 < values.length && values[i + 1] != null) queue.offer(node.right = new TreeNode(values[i + 1]));\n        }\n        return root;\n    }\n}\n","steps":[{"event":"step","line":17,"frames":[{"method":"main","class":"ValidateBST","line":28,"locals":[["root",{"ref":"132"}]]},{"method":"isValidBST","class":"ValidateBST","line":17,"locals":[["root",{"ref":"132"}]]}],"heap":{"132":{"type":"ValidateBST.TreeNode