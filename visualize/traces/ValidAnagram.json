{"program":"ValidAnagram","meta":{"title":"Valid Anagram (count letters with a HashMap)","leetcode":"valid-anagram","expect":"true","start":"isAnagram"},"code":"// @title Valid Anagram (count letters with a HashMap)\n// @leetcode valid-anagram\n// @expect true\n// @start isAnagram\nimport java.util.HashMap;\nimport java.util.Map;\n\npublic class ValidAnagram {\n    public static boolean isAnagram(String s, String t) {\n        if (s.length() != t.length()) return false;\n        Map<Character, Integer> count = new HashMap<>();\n        for (char c : s.toCharArray()) {\n            count.merge(c, 1, Integer::sum);                 // count each letter of s\n        }\n        for (char c : t.toCharArray()) {\n            int remaining = count.getOrDefault(c, 0) - 1;    // use one up for t\n            if (remaining < 0) return false;                 // t has more of c than s\n            count.put(c, remaining);\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(isAnagram(\"anagram\", \"nagaram\"));\n    }\n}\n","steps":[{"event":"step","line":10,"frames":[{"method":"main","class":"ValidAnagram","line":24,"locals":[]},{"method":"isAnagram","class":"ValidAnagram","line":10,"locals":[["s",{"s":"anagram"}],["t",{"s":"nagaram"}]]}],"heap":{},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"ValidAnagram","line":24,"locals":[]},{"method":"isAnagram","class":"ValidAnagram","line":11,"locals":[["s",{"s":"anagram"}],["t",{"s":"nagaram"}]]}],"heap":{},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"ValidAnagram","line":24,"locals":[]},{"method":"isAnagram","class":"ValidAnagram","line":12,"locals":[["s",{"s":"anagram"}],["t",{"s":"nagaram"}],["count",{"ref":"71"}]]}],"heap":{"71":{"type":"HashMap","kind":"map","entries":[]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"ValidAnagram","line":24,"locals":[]},{"method":"isAnagram","class":"Valid