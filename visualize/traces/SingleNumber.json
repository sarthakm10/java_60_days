{"program":"SingleNumber","meta":{"title":"Single Number (XOR cancels pairs)","leetcode":"single-number","expect":"4","start":"singleNumber"},"code":"// @title Single Number (XOR cancels pairs)\n// @leetcode single-number\n// @expect 4\n// @start singleNumber\npublic class SingleNumber {\n    public static int singleNumber(int[] nums) {\n        int result = 0;\n        for (int x : nums) {\n            result ^= x;          // a ^ a = 0 and a ^ 0 = a, so pairs cancel out\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {4, 1, 2, 1, 2};\n        System.out.println(singleNumber(nums));\n    }\n}\n","steps":[{"event":"step","line":7,"frames":[{"method":"main","class":"SingleNumber","line":16,"locals":[["nums",{"ref":"64"}]]},{"method":"singleNumber","class":"SingleNumber","line":7,"locals":[["nums",{"ref":"64"}]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[4,1,2,1,2]}},"out":""},{"event":"step","line":8,"frames":[{"method":"main","class":"SingleNumber","line":16,"locals":[["nums",{"ref":"64"}]]},{"method":"singleNumber","class":"SingleNumber","line":8,"locals":[["nums",{"ref":"64"}],["result",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[4,1,2,1,2]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"SingleNumber","line":16,"locals":[["nums",{"ref":"64"}]]},{"method":"singleNumber","class":"SingleNumber","line":9,"locals":[["nums",{"ref":"64"}],["result",0],["x",4]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[4,1,2,1,2]}},"out":""},{"event":"step","line":8,"frames":[{"method":"main","class":"SingleNumber","line":16,"locals":[["nums",{"ref":"64"}]]},{"method":"singleNumber","class":"SingleNumber","line":8,"locals":[["nums",{"ref":"64"}],["result",4]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[4,1,2,1,2]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"SingleNumber","line":16