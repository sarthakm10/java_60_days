{"program":"JumpGame","meta":{"title":"Jump Game (greedy: how far can we reach?)","leetcode":"jump-game","expect":"true","start":"canJump","pointers":"nums: i reach","window":"nums: 0 reach"},"code":"// @title Jump Game (greedy: how far can we reach?)\n// @leetcode jump-game\n// @expect true\n// @start canJump\n// @pointers nums: i reach\n// @window nums: 0 reach\npublic class JumpGame {\n    public static boolean canJump(int[] nums) {\n        int reach = 0;                                // farthest index we can get to so far\n        for (int i = 0; i < nums.length; i++) {\n            if (i > reach) return false;              // i is out of reach: stuck\n            reach = Math.max(reach, i + nums[i]);\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {2, 3, 1, 1, 4};\n        System.out.println(canJump(nums));\n    }\n}\n","steps":[{"event":"step","line":9,"frames":[{"method":"main","class":"JumpGame","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"canJump","class":"JumpGame","line":9,"locals":[["nums",{"ref":"63"}]]}],"heap":{"63":{"type":"int[]","kind":"array","length":5,"items":[2,3,1,1,4]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"JumpGame","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"canJump","class":"JumpGame","line":10,"locals":[["nums",{"ref":"63"}],["reach",0]]}],"heap":{"63":{"type":"int[]","kind":"array","length":5,"items":[2,3,1,1,4]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"JumpGame","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"canJump","class":"JumpGame","line":11,"locals":[["nums",{"ref":"63"}],["reach",0],["i",0]]}],"heap":{"63":{"type":"int[]","kind":"array","length":5,"items":[2,3,1,1,4]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"JumpGame","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"canJump","class":"JumpGame","line":12,"locals":[["nums",{"ref":"63"}],["