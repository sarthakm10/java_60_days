{"program":"ReverseLinkedList","meta":{"title":"Reverse a linked list (prev / curr / next)","leetcode":"reverse-linked-list","expect":"3 2 1","start":"reverseList"},"code":"// @title Reverse a linked list (prev / curr / next)\n// @leetcode reverse-linked-list\n// @expect 3 2 1\n// @start reverseList\npublic class ReverseLinkedList {\n    static class ListNode {\n        int val;\n        ListNode next;\n        ListNode(int val) { this.val = val; }\n    }\n\n    public static ListNode reverseList(ListNode head) {\n        ListNode prev = null, curr = head;\n        while (curr != null) {\n            ListNode next = curr.next;   // 1. save the rest of the list\n            curr.next = prev;            // 2. reverse this pointer\n            prev = curr;                 // 3. move prev forward\n            curr = next;                 // 4. move curr forward\n        }\n        return prev;                     // prev is the new head\n    }\n\n    public static void main(String[] args) {\n        ListNode head = new ListNode(1);\n        head.next = new ListNode(2);\n        head.next.next = new ListNode(3);\n        ListNode reversed = reverseList(head);\n        for (ListNode n = reversed; n != null; n = n.next) System.out.print(n.val + \" \");\n        System.out.println();\n    }\n}\n","steps":[{"event":"step","line":13,"frames":[{"method":"main","class":"ReverseLinkedList","line":27,"locals":[["head",{"ref":"65"}]]},{"method":"reverseList","class":"ReverseLinkedList","line":13,"locals":[["head",{"ref":"65"}]]}],"heap":{"65":{"type":"ReverseLinkedList.ListNode","kind":"object","fields":[["val",1],["next",{"ref":"66"}]]},"66":{"type":"ReverseLinkedList.ListNode","kind":"object","fields":[["val",2],["next",{"ref":"67"}]]},"67":{"type":"ReverseLinkedList.ListNode","kind":"object","fields":[["val",3],["next",null]]}},"out":""},{"event":"step","line":14,"frames":[{"method":"main","class":"ReverseLinkedList","line":27,"locals":[["head",{"ref":"65"}]]},{"method":"revers