{"program":"TwoSumSorted","meta":{"title":"Two Sum II — sorted array (two pointers)","start":"twoSum","pointers":"numbers: left right"},"code":"// @title Two Sum II — sorted array (two pointers)\n// @start twoSum\n// @pointers numbers: left right\nimport java.util.Arrays;\n\npublic class TwoSumSorted {\n    public static int[] twoSum(int[] numbers, int target) {\n        int left = 0, right = numbers.length - 1;\n        while (left < right) {\n            int sum = numbers[left] + numbers[right];\n            if (sum == target) return new int[]{left + 1, right + 1};   // 1-indexed\n            if (sum < target) left++;       // need a bigger sum\n            else right--;                   // need a smaller sum\n        }\n        return new int[]{-1, -1};\n    }\n\n    public static void main(String[] args) {\n        int[] numbers = {2, 7, 11, 15};\n        System.out.println(Arrays.toString(twoSum(numbers, 9)));\n    }\n}\n","steps":[{"event":"step","line":8,"frames":[{"method":"main","class":"TwoSumSorted","line":20,"locals":[["numbers",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumSorted","line":8,"locals":[["numbers",{"ref":"63"}],["target",9]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"TwoSumSorted","line":20,"locals":[["numbers",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumSorted","line":9,"locals":[["numbers",{"ref":"63"}],["target",9],["left",0],["right",3]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"TwoSumSorted","line":20,"locals":[["numbers",{"ref":"63"}]]},{"method":"twoSum","class":"TwoSumSorted","line":10,"locals":[["numbers",{"ref":"63"}],["target",9],["left",0],["right",3]]}],"heap":{"63":{"type":"int[]","kind":"array","length":4,"items":[2,7,11,15]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"TwoSu