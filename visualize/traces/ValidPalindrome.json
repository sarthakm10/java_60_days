{"program":"ValidPalindrome","meta":{"title":"Valid Palindrome (two pointers on a string)","leetcode":"valid-palindrome","expect":"true","start":"isPalindrome","pointers":"s: left right"},"code":"// @title Valid Palindrome (two pointers on a string)\n// @leetcode valid-palindrome\n// @expect true\n// @start isPalindrome\n// @pointers s: left right\npublic class ValidPalindrome {\n    public static boolean isPalindrome(String s) {\n        int left = 0, right = s.length() - 1;\n        while (left < right) {\n            while (left < right && !Character.isLetterOrDigit(s.charAt(left))) left++;    // skip spaces and punctuation\n            while (left < right && !Character.isLetterOrDigit(s.charAt(right))) right--;\n            if (Character.toLowerCase(s.charAt(left)) != Character.toLowerCase(s.charAt(right))) return false;\n            left++;\n            right--;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(isPalindrome(\"A man, a plan, a canal: Panama\"));\n    }\n}\n","steps":[{"event":"step","line":8,"frames":[{"method":"main","class":"ValidPalindrome","line":20,"locals":[]},{"method":"isPalindrome","class":"ValidPalindrome","line":8,"locals":[["s",{"s":"A man, a plan, a canal: Panama"}]]}],"heap":{},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"ValidPalindrome","line":20,"locals":[]},{"method":"isPalindrome","class":"ValidPalindrome","line":9,"locals":[["s",{"s":"A man, a plan, a canal: Panama"}],["left",0],["right",29]]}],"heap":{},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"ValidPalindrome","line":20,"locals":[]},{"method":"isPalindrome","class":"ValidPalindrome","line":10,"locals":[["s",{"s":"A man, a plan, a canal: Panama"}],["left",0],["right",29]]}],"heap":{},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"ValidPalindrome","line":20,"locals":[]},{"method":"isPalindrome","class":"ValidPalindrome","line":11,"