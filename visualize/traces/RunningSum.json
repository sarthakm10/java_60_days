{"program":"RunningSum","meta":{"title":"Running Sum of 1d Array (prefix sums in place)","leetcode":"running-sum-of-1d-array","expect":"[1, 3, 6, 10]","start":"runningSum","pointers":"nums: i"},"code":"// @title Running Sum of 1d Array (prefix sums in place)\n// @leetcode running-sum-of-1d-array\n// @expect [1, 3, 6, 10]\n// @start runningSum\n// @pointers nums: i\nimport java.util.Arrays;\n\npublic class RunningSum {\n    public static int[] runningSum(int[] nums) {\n        for (int i = 1; i < nums.length; i++) {\n            nums[i] += nums[i - 1];      // each cell becomes the sum of everything up to it\n        }\n        return nums;\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {1, 2, 3, 4};\n        System.out.println(Arrays.toString(runningSum(nums)));\n    }\n}\n","steps":[{"event":"step","line":10,"frames":[{"method":"main","class":"RunningSum","line":18,"locals":[["nums",{"ref":"64"}]]},{"method":"runningSum","class":"RunningSum","line":10,"locals":[["nums",{"ref":"64"}]]}],"heap":{"64":{"type":"int[]","kind":"array","length":4,"items":[1,2,3,4]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"RunningSum","line":18,"locals":[["nums",{"ref":"64"}]]},{"method":"runningSum","class":"RunningSum","line":11,"locals":[["nums",{"ref":"64"}],["i",1]]}],"heap":{"64":{"type":"int[]","kind":"array","length":4,"items":[1,2,3,4]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"RunningSum","line":18,"locals":[["nums",{"ref":"64"}]]},{"method":"runningSum","class":"RunningSum","line":10,"locals":[["nums",{"ref":"64"}],["i",1]]}],"heap":{"64":{"type":"int[]","kind":"array","length":4,"items":[1,3,3,4]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"RunningSum","line":18,"locals":[["nums",{"ref":"64"}]]},{"method":"runningSum","class":"RunningSum","line":11,"locals":[["nums",{"ref":"64"}],["i",2]]}],"heap":{"64":{"type":"int[]","kind":"array","length":4,"items":[1,3,