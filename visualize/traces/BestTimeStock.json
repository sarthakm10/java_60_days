{"program":"BestTimeStock","meta":{"title":"Best Time to Buy and Sell Stock (track the cheapest day so far)","leetcode":"best-time-to-buy-and-sell-stock","expect":"5","start":"maxProfit","pointers":"prices: day"},"code":"// @title Best Time to Buy and Sell Stock (track the cheapest day so far)\n// @leetcode best-time-to-buy-and-sell-stock\n// @expect 5\n// @start maxProfit\n// @pointers prices: day\npublic class BestTimeStock {\n    public static int maxProfit(int[] prices) {\n        int minPrice = Integer.MAX_VALUE, best = 0;\n        for (int day = 0; day < prices.length; day++) {\n            if (prices[day] < minPrice) minPrice = prices[day];          // a cheaper day to buy\n            else best = Math.max(best, prices[day] - minPrice);         // or: what if we sell today?\n        }\n        return best;\n    }\n\n    public static void main(String[] args) {\n        int[] prices = {7, 1, 5, 3, 6, 4};\n        System.out.println(maxProfit(prices));\n    }\n}\n","steps":[{"event":"step","line":8,"frames":[{"method":"main","class":"BestTimeStock","line":18,"locals":[["prices",{"ref":"64"}]]},{"method":"maxProfit","class":"BestTimeStock","line":8,"locals":[["prices",{"ref":"64"}]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items":[7,1,5,3,6,4]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"BestTimeStock","line":18,"locals":[["prices",{"ref":"64"}]]},{"method":"maxProfit","class":"BestTimeStock","line":9,"locals":[["prices",{"ref":"64"}],["minPrice",2147483647],["best",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items":[7,1,5,3,6,4]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"BestTimeStock","line":18,"locals":[["prices",{"ref":"64"}]]},{"method":"maxProfit","class":"BestTimeStock","line":10,"locals":[["prices",{"ref":"64"}],["minPrice",2147483647],["best",0],["day",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":6,"items":[7,1,5,3,6,4]}},"out":""},{"event":"step"