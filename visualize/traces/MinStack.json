{"program":"MinStack","meta":{"title":"Min Stack (a second stack remembers the minimum)","leetcode":"min-stack","expect":"-3 0 -2"},"code":"// @title Min Stack (a second stack remembers the minimum)\n// @leetcode min-stack\n// @expect -3 0 -2\nimport java.util.ArrayDeque;\nimport java.util.Deque;\n\npublic class MinStack {\n    private final Deque<Integer> stack = new ArrayDeque<>();\n    private final Deque<Integer> minStack = new ArrayDeque<>();   // its top is the smallest value in stack\n\n    public void push(int val) {\n        stack.push(val);\n        if (minStack.isEmpty() || val <= minStack.peek()) minStack.push(val);\n    }\n\n    public void pop() {\n        if (stack.pop().equals(minStack.peek())) minStack.pop();  // the minimum is leaving\n    }\n\n    public int top() {\n        return stack.peek();\n    }\n\n    public int getMin() {\n        return minStack.peek();\n    }\n\n    public static void main(String[] args) {\n        MinStack s = new MinStack();\n        s.push(-2);\n        s.push(0);\n        s.push(-3);\n        int a = s.getMin();\n        s.pop();\n        int b = s.top();\n        int c = s.getMin();\n        System.out.println(a + \" \" + b + \" \" + c);\n    }\n}\n","steps":[{"event":"step","line":29,"frames":[{"method":"main","class":"MinStack","line":29,"locals":[]}],"heap":{},"out":""},{"event":"step","line":7,"frames":[{"method":"main","class":"MinStack","line":29,"locals":[]},{"method":"<init>","class":"MinStack","line":7,"locals":[["this",{"ref":"69"}]]}],"heap":{"69":{"type":"MinStack","kind":"object","fields":[["stack",null],["minStack",null]]}},"out":""},{"event":"step","line":8,"frames":[{"method":"main","class":"MinStack","line":29,"locals":[]},{"method":"<init>","class":"MinStack","line":8,"locals":[["this",{"ref":"69"}]]}],"heap":{"69":{"type":"MinStack","kind":"object","fields":[["stack",null],["minStack",null]]}},"out":""},{"event":"step","line":9,"frames":[{"method":"main","class":"MinStack","line":29,"locals":[]},