{"program":"KthLargest","meta":{"title":"Kth Largest Element in an Array (a min-heap of size k)","leetcode":"kth-largest-element-in-an-array","expect":"5","start":"findKthLargest"},"code":"// @title Kth Largest Element in an Array (a min-heap of size k)\n// @leetcode kth-largest-element-in-an-array\n// @expect 5\n// @start findKthLargest\nimport java.util.PriorityQueue;\n\npublic class KthLargest {\n    public static int findKthLargest(int[] nums, int k) {\n        PriorityQueue<Integer> heap = new PriorityQueue<>();   // min-heap: the k largest seen so far\n        for (int x : nums) {\n            heap.offer(x);\n            if (heap.size() > k) heap.poll();                    // too many: drop the smallest\n        }\n        return heap.peek();                                      // the smallest of the k largest\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {3, 2, 1, 5, 6, 4};\n        System.out.println(findKthLargest(nums, 2));\n    }\n}\n","steps":[{"event":"step","line":9,"frames":[{"method":"main","class":"KthLargest","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"findKthLargest","class":"KthLargest","line":9,"locals":[["nums",{"ref":"63"}],["k",2]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[3,2,1,5,6,4]}},"out":""},{"event":"step","line":10,"frames":[{"method":"main","class":"KthLargest","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"findKthLargest","class":"KthLargest","line":10,"locals":[["nums",{"ref":"63"}],["k",2],["heap",{"ref":"72"}]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"items":[3,2,1,5,6,4]},"72":{"type":"PriorityQueue","kind":"pq","items":[]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"KthLargest","line":19,"locals":[["nums",{"ref":"63"}]]},{"method":"findKthLargest","class":"KthLargest","line":11,"locals":[["nums",{"ref":"63"}],["k",2],["heap",{"ref":"72"}],["x",3]]}],"heap":{"63":{"type":"int[]","kind":"array","length":6,"item