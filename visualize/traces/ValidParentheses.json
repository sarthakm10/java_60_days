{"program":"ValidParentheses","meta":{"title":"Valid Parentheses (a stack of expected closers)","leetcode":"valid-parentheses","expect":"true","start":"isValid"},"code":"// @title Valid Parentheses (a stack of expected closers)\n// @leetcode valid-parentheses\n// @expect true\n// @start isValid\nimport java.util.ArrayDeque;\nimport java.util.Deque;\n\npublic class ValidParentheses {\n    public static boolean isValid(String s) {\n        Deque<Character> stack = new ArrayDeque<>();\n        for (char c : s.toCharArray()) {\n            if (c == '(') stack.push(')');            // remember which closer we now expect\n            else if (c == '[') stack.push(']');\n            else if (c == '{') stack.push('}');\n            else if (stack.isEmpty() || stack.pop() != c) return false;   // wrong closer, or nothing open\n        }\n        return stack.isEmpty();                       // anything left open is an error\n    }\n\n    public static void main(String[] args) {\n        System.out.println(isValid(\"{[()]}\"));\n    }\n}\n","steps":[{"event":"step","line":10,"frames":[{"method":"main","class":"ValidParentheses","line":21,"locals":[]},{"method":"isValid","class":"ValidParentheses","line":10,"locals":[["s",{"s":"{[()]}"}]]}],"heap":{},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"ValidParentheses","line":21,"locals":[]},{"method":"isValid","class":"ValidParentheses","line":11,"locals":[["s",{"s":"{[()]}"}],["stack",{"ref":"70"}]]}],"heap":{"70":{"type":"ArrayDeque","kind":"deque","items":[]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"ValidParentheses","line":21,"locals":[]},{"method":"isValid","class":"ValidParentheses","line":12,"locals":[["s",{"s":"{[()]}"}],["stack",{"ref":"70"}],["c",{"c":"{"}]]}],"heap":{"70":{"type":"ArrayDeque","kind":"deque","items":[]}},"out":""},{"event":"step","line":13,"frames":[{"method":"main","class":"ValidParentheses","line":21,"locals":[]},{"method":"isValid","class":"Vali