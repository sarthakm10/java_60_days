{"program":"MoveZeroes","meta":{"title":"Move Zeroes (read and write pointers)","leetcode":"move-zeroes","expect":"[1, 3, 12, 0, 0]","start":"moveZeroes","pointers":"nums: write read"},"code":"// @title Move Zeroes (read and write pointers)\n// @leetcode move-zeroes\n// @expect [1, 3, 12, 0, 0]\n// @start moveZeroes\n// @pointers nums: write read\nimport java.util.Arrays;\n\npublic class MoveZeroes {\n    public static void moveZeroes(int[] nums) {\n        int write = 0;                                    // where the next non-zero goes\n        for (int read = 0; read < nums.length; read++) {\n            if (nums[read] != 0) {\n                int tmp = nums[write];\n                nums[write] = nums[read];\n                nums[read] = tmp;\n                write++;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        int[] nums = {0, 1, 0, 3, 12};\n        moveZeroes(nums);\n        System.out.println(Arrays.toString(nums));\n    }\n}\n","steps":[{"event":"step","line":10,"frames":[{"method":"main","class":"MoveZeroes","line":23,"locals":[["nums",{"ref":"64"}]]},{"method":"moveZeroes","class":"MoveZeroes","line":10,"locals":[["nums",{"ref":"64"}]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[0,1,0,3,12]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"MoveZeroes","line":23,"locals":[["nums",{"ref":"64"}]]},{"method":"moveZeroes","class":"MoveZeroes","line":11,"locals":[["nums",{"ref":"64"}],["write",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[0,1,0,3,12]}},"out":""},{"event":"step","line":12,"frames":[{"method":"main","class":"MoveZeroes","line":23,"locals":[["nums",{"ref":"64"}]]},{"method":"moveZeroes","class":"MoveZeroes","line":12,"locals":[["nums",{"ref":"64"}],["write",0],["read",0]]}],"heap":{"64":{"type":"int[]","kind":"array","length":5,"items":[0,1,0,3,12]}},"out":""},{"event":"step","line":11,"frames":[{"method":"main","class":"MoveZeroes","l